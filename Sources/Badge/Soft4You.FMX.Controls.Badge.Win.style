object TLayout	Align = Client	StyleName = 'S4YBadgeStyle'	object TRectangle		StyleName = 'background'		Align = Client		CornerType = Round		Fill.Color = claRed		HitTest = False		Padding.Left = 6		Padding.Right = 6		Size.PlatformDefault = False		Stroke.Kind = Solid		Stroke.Color = claWhite		XRadius = 8		YRadius = 8		object TText			Align = Client			HitTest = False			StyleName = 'text'			TextSettings.FontColor = claWhite			TextSettings.HorzAlign = Center			TextSettings.VertAlign = Center			TextSettings.Trimming = None			TextSettings.WordWrap = False		end	endend