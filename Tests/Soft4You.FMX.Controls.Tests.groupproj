<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{316CA55D-6F69-4DAB-A369-9F6556DB9D72}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="FlexBox\S4YFlexBoxTests.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="BlockScrollBox\S4YBlockScrollBoxTests.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="S4YFlexBoxTests">
        <MSBuild Projects="FlexBox\S4YFlexBoxTests.dproj"/>
    </Target>
    <Target Name="S4YFlexBoxTests:Clean">
        <MSBuild Projects="FlexBox\S4YFlexBoxTests.dproj" Targets="Clean"/>
    </Target>
    <Target Name="S4YFlexBoxTests:Make">
        <MSBuild Projects="FlexBox\S4YFlexBoxTests.dproj" Targets="Make"/>
    </Target>
    <Target Name="S4YBlockScrollBoxTests">
        <MSBuild Projects="BlockScrollBox\S4YBlockScrollBoxTests.dproj"/>
    </Target>
    <Target Name="S4YBlockScrollBoxTests:Clean">
        <MSBuild Projects="BlockScrollBox\S4YBlockScrollBoxTests.dproj" Targets="Clean"/>
    </Target>
    <Target Name="S4YBlockScrollBoxTests:Make">
        <MSBuild Projects="BlockScrollBox\S4YBlockScrollBoxTests.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="S4YFlexBoxTests;S4YBlockScrollBoxTests"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="S4YFlexBoxTests:Clean;S4YBlockScrollBoxTests:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="S4YFlexBoxTests:Make;S4YBlockScrollBoxTests:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
