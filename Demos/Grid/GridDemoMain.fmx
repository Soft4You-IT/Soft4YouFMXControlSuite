        TextSettings.VertAlign = Leading
        Text = 
          'A style of the grid in the TStyleBook of the form, chosen with S' +
          'tyleLookup = DarkGridStyle: a dark background and lines, with th' +
          'e parts filterrowbackground, footerbackground, footertext and fi' +
          'lterinvalidtext (the color of a filter that cannot be read, such' +
          ' as "> abc" on the orders). The fields of the filters have a dar' +
          'k style (FilterRow.EditStyleLookup = DarkEditStyle), and the men' +
          'u a dark popup and items with a light text: FilterRow.MenuStyleL' +
          'ookup = DarkMenuStyle and FilterRow.MenuItemStyleLookup = DarkMe' +
          'nuItemStyle.'
        TabOrder = 0
      end
