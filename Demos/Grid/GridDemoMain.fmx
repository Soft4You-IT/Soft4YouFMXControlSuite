        Size.Width = 800.000000000000000000
        Size.Height = 56.000000000000000000
        Size.PlatformDefault = False
        TextSettings.VertAlign = Leading
        Text = 
          'The same customers in a TFDMemTable, shown through the LiveBindi' +
          'ngs (TBindSourceDB and TLinkGridToDataSource). The data set filt' +
          'ers itself in OnFilterRecord with the filter values of the name,' +
          ' the city and the check box; the footer reads the rows through t' +
          'he link. A click on a header sorts the data set with its IndexFi' +
          'eldNames, Shift+click by more columns.'
      end
