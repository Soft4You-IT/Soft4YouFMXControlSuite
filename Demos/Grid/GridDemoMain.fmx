      object ObjectsLayout: TLayout
        Align = Client
        Size.Width = 830.000000000000000000
        Size.Height = 674.000000000000000000
        Size.PlatformDefault = False
        TabOrder = 0
        object ObjectsLabel: TLabel
          Align = Top
          Margins.Left = 12.000000000000000000
          Margins.Top = 8.000000000000000000
          Margins.Right = 12.000000000000000000
          Position.X = 12.000000000000000000
          Position.Y = 8.000000000000000000
          Size.Width = 806.000000000000000000
          Size.Height = 120.000000000000000000
          Size.PlatformDefault = False
          TextSettings.VertAlign = Leading
          Text = 
            '200 customers in a list of objects, shown with OnGetValue. In On' +
            'Filter the application keeps the customers that pass FilterMatch' +
            'es, which applies the text of each filter: abc contains, = abc e' +
            'qual, ! abc the opposite (does not contain, not equal), abc* sta' +
            'rts with, *abc ends with, < <= > >= compare numbers, dates and t' +
            'imes, = alone is empty, <> alone is not empty, "..." is text as ' +
            'it is. The button of a filter opens its menu (the amount has an ' +
            'item of the application). Status is an integer column that shows' +
            ' texts: its FilterItems are Text=Value lines (SetFilterEnum), so' +
            ' its filter shows the texts and gives the values. Enter filters,' +
            ' Esc clears a filter; the button on the right of the header or C' +
            'trl+Shift+F shows or hides the filter row, and the filters apply' +
            ' only while it is shown. A click on a header sorts in OnSort, Sh' +
            'ift+click adds a column, Ctrl+click removes it, Alt+click goes b' +
            'ack to the order of the data.'
        end
