        object ObjectsLabel: TLabel
          Align = Top
          Margins.Left = 12.000000000000000000
          Margins.Top = 8.000000000000000000
          Margins.Right = 12.000000000000000000
          Size.Width = 800.000000000000000000
          Size.Height = 56.000000000000000000
          Size.PlatformDefault = False
          TextSettings.VertAlign = Leading
          Text = 
            '200 customers in a list of objects, shown with OnGetValue. The a' +
            'pplication filters them in OnFilter: "contains" for the name, "e' +
            'qual" for the others. Type in the filter row and press Enter, Es' +
            'c clears a filter; the footer shows the totals of the rows shown' +
            '. A click on a header sorts in OnSort, Shift+click adds a column' +
            ', Ctrl+click removes it, Alt+click goes back to the order of the' +
            ' data.'
        end
