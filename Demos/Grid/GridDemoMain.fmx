        Position.Y = 8.000000000000000000
        Size.Width = 1076.000000000000000000
        Size.Height = 56.000000000000000000
        Size.PlatformDefault = False
        TextSettings.VertAlign = Leading
        Text = 
          'The same customers in a TFDMemTable, shown through the LiveBindi' +
          'ngs (TBindSourceDB and TLinkGridToDataSource). The data set filt' +
          'ers itself in OnFilterRecord: the grid compares each field with ' +
          'the filter of its column with FilterMatches. The footer reads th' +
          'e rows through the link. A click on a header sorts the data set ' +
          'with its IndexFieldNames, Shift+click by more columns.'
        TabOrder = 0
      end
