          item
            Caption = 'Index'
          end
          item
            Caption = 'Done'
            Marker.Content = smcNone
            MarkerStates = [sstCurrent]
            MarkerStyleName = 'endmarker'
          end>
      end
    end
    object DarkTab: TTabItem
      Text = 'Dark theme'
      object DarkBackground: TRectangle
        Align = Client
        Fill.Color = xFF263238
        Size.PlatformDefault = False
        Stroke.Kind = None
        object DarkLabel: TLabel
          Align = Top
          StyledSettings = [Family, Size, Style]
          Margins.Left = 16
          Margins.Top = 16
          Margins.Right = 16
          Size.Height = 40
          Size.PlatformDefault = False
          TextSettings.FontColor = xFFECEFF1
          TextSettings.VertAlign = Leading
