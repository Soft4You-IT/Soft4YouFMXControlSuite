object StepProgressBarGalleryForm: TStepProgressBarGalleryForm
  Left = 0
  Top = 0
  Caption = 'TS4YStepProgressBar gallery'
  ClientHeight = 520
  ClientWidth = 980
  Position = ScreenCenter
  StyleBook = GalleryStyleBook
  FormFactor.Width = 320
  FormFactor.Height = 480
  FormFactor.Devices = [Desktop]
  DesignerMasterStyle = 0
  object GalleryTabControl: TTabControl
    Align = Client
    Size.Width = 980
    Size.Height = 520
    Size.PlatformDefault = False
    TabIndex = 0
    TabOrder = 0
    TabPosition = Top
    object InstallTab: TTabItem
      IsSelected = True
      Text = 'Installation'
      object InstallLabel: TLabel
        Align = Top
        Margins.Left = 16
        Margins.Top = 16
        Margins.Right = 16
        Size.Height = 40
        Size.PlatformDefault = False
        TextSettings.VertAlign = Leading
        Text = 
          'The default style: numbers in the markers, captions and descript' +
          'ions, a start and an end marker. Click a step to select it.'
      end
      object InstallBar: TS4YStepProgressBar
        Align = Top
        CurrentStep = 2
        Interactions = [stiClickMarker, stiClickLabel, stiHandCursor, stiKeyboard, stiHover]
        Margins.Left = 16
        Margins.Top = 16
        Margins.Right = 16
        Size.Height = 90
        Size.PlatformDefault = False
        TabOrder = 1
        StepItems = <
          item
            Caption = 'Start'
            Marker.Content = smcNone
            MarkerStates = [sstCompleted, sstCurrent]
            MarkerStyleName = 'startmarker'
          end
          item
            Caption = 'Download'
            Description = 'Package of 12 MB'
          end
          item
            Caption = 'Verify'
            Description = 'Checksum and signature'
          end
          item
            Caption = 'Copy files'
          end
          item
            Caption = 'Finish'
            Marker.Content = smcNone
            MarkerStates = [sstCurrent]
            MarkerStyleName = 'endmarker'
          end>
      end
    end
    object CheckoutTab: TTabItem
      Text = 'Failed step'
      object CheckoutLabel: TLabel
        Align = Top
        Margins.Left = 16
        Margins.Top = 16
        Margins.Right = 16
        Size.Height = 40
        Size.PlatformDefault = False
        TextSettings.VertAlign = Leading
        Text = 
          'A checkout where the payment has failed: a step with Failed = Tr' +
          'ue is drawn as failed, wherever it is.'
      end
      object CheckoutBar: TS4YStepProgressBar
        Align = Top
        CurrentStep = 2
        Interactions = [stiClickMarker, stiClickLabel, stiHandCursor, stiKeyboard, stiHover]
        Margins.Left = 16
        Margins.Top = 16
        Margins.Right = 16
        Size.Height = 90
        Size.PlatformDefault = False
        TabOrder = 1
        StepItems = <
          item
            Caption = 'Cart'
            Description = '3 items'
          end
          item
            Caption = 'Shipping'
            Description = 'Standard, 2-4 days'
          end
          item
            Caption = 'Payment'
            Description = 'Card declined'
            Failed = True
          end
          item
            Caption = 'Confirmation'
          end>
      end
    end
    object TrackingTab: TTabItem
      Text = 'Vertical timeline'
      object TrackingLabel: TLabel
        Align = Top
        Margins.Left = 16
        Margins.Top = 16
        Margins.Right = 16
        Size.Height = 40
        Size.PlatformDefault = False
        TextSettings.VertAlign = Leading
        Text = 
          'The tracking of a parcel: a vertical line, small markers without' +
          ' numbers beside the line (MarkerPosition = smpBefore).'
      end
      object TrackingBar: TS4YStepProgressBar
        Align = Top
        CompletedMarker.Content = smcNone
        CurrentMarker.Content = smcNone
        CurrentStep = 2
        FailedMarker.Content = smcNone
        Interactions = [stiClickMarker, stiClickLabel, stiHandCursor, stiKeyboard, stiHover]
        LabelSpacing = 12
        LineSpacing = 6
        LineThickness = 2
        Margins.Left = 16
        Margins.Top = 16
        Margins.Right = 16
        MarkerPosition = smpBefore
        MarkerSize.Height = 14
        MarkerSize.Width = 14
        Orientation = Vertical
        PendingMarker.Content = smcNone
        Size.Height = 340
        Size.PlatformDefault = False
        TabOrder = 1
        StepItems = <
          item
            Caption = 'Order placed'
            Description = 'November 10, 09:14'
          end
          item
            Caption = 'Shipped'
            Description = 'November 10, 17:40'
          end
          item
            Caption = 'In transit'
            Description = 'November 11, 06:02 - Sorting center'
          end
          item
            Caption = 'Out for delivery'
          end
          item
            Caption = 'Delivered'
          end>
      end
    end
    object ImagesTab: TTabItem
      Text = 'Images'
      object ImagesLabel: TLabel
        Align = Top
        Margins.Left = 16
        Margins.Top = 16
        Margins.Right = 16
        Size.Height = 40
        Size.PlatformDefault = False
        TextSettings.VertAlign = Leading
        Text = 
          'An order with an image in each marker: Content = smcImage, Image' +
          's set to an image list and ImageIndex of each step.'
      end
      object ImagesBar: TS4YStepProgressBar
        Align = Top
        CompletedMarker.Content = smcImage
        CompletedMarker.Fill.Color = xFFE3F2FD
        CurrentMarker.Content = smcImage
        CurrentStep = 2
        FailedMarker.Content = smcImage
        Images = OrderImages
        Interactions = [stiClickMarker, stiClickLabel, stiHandCursor, stiKeyboard, stiHover]
        Margins.Left = 16
        Margins.Top = 16
        Margins.Right = 16
        MarkerSize.Height = 40
        MarkerSize.Width = 40
        PendingMarker.Content = smcImage
        Size.Height = 100
        Size.PlatformDefault = False
        TabOrder = 1
        StepItems = <
          item
            Caption = 'Cart'
            ImageIndex = 0
          end
          item
            Caption = 'Address'
            ImageIndex = 1
          end
          item
            Caption = 'Payment'
            ImageIndex = 2
          end
          item
            Caption = 'Shipping'
            ImageIndex = 3
          end
          item
            Caption = 'Delivered'
            ImageIndex = 4
          end>
      end
    end
    object DotsTab: TTabItem
      Text = 'Page dots'
      object DotsLabel: TLabel
        Align = Top
        Margins.Left = 16
        Margins.Top = 16
        Margins.Right = 16
        Size.Height = 40
        Size.PlatformDefault = False
        TextSettings.VertAlign = Leading
        Text = 
          'The dots of a sequence of pages: no line, no labels, small grey ' +
          'markers and a wider current one. Click a dot.'
      end
      object DotsLayout: TLayout
        Align = Top
        Margins.Top = 16
        Size.Height = 40
        Size.PlatformDefault = False
        TabOrder = 1
        object DotsBar: TS4YStepProgressBar
          Align = Center
          CompletedMarker.Content = smcNone
          CompletedMarker.Fill.Color = xFFBDBDBD
          CompletedMarker.Stroke.Color = xFFBDBDBD
          CurrentMarker.Content = smcNone
          CurrentMarker.Fill.Color = xFF1E88E5
          CurrentMarker.Size.Width = 26
          CurrentStep = 1
          FailedMarker.Content = smcNone
          Interactions = [stiClickMarker, stiHandCursor, stiKeyboard]
          LabelPosition = slpNone
          Line.Visible = False
          MarkerSize.Height = 10
          MarkerSize.Width = 10
          PendingMarker.Content = smcNone
          PendingMarker.Fill.Color = xFFBDBDBD
          PendingMarker.Stroke.Color = xFFBDBDBD
          Size.Width = 180
          Size.Height = 24
          Size.PlatformDefault = False
          TabOrder = 0
          StepItems = <
            item
            end
            item
            end
            item
            end
            item
            end
            item
            end
            item
            end>
        end
      end
    end
    object SizesTab: TTabItem
      Text = 'Sizes by state'
      object SizesLabel: TLabel
        Align = Top
        Margins.Left = 16
        Margins.Top = 16
        Margins.Right = 16
        Size.Height = 40
        Size.PlatformDefault = False
        TextSettings.VertAlign = Leading
        Text = 
          'Each state with a size of its own: small pending markers without' +
          ' number, medium completed markers and a large current one.'
      end
      object SizesBar: TS4YStepProgressBar
        Align = Top
        CompletedMarker.Size.Height = 24
        CompletedMarker.Size.Width = 24
        CurrentMarker.Size.Height = 40
        CurrentMarker.Size.Width = 40
        CurrentStep = 2
        Interactions = [stiClickMarker, stiClickLabel, stiHandCursor, stiKeyboard, stiHover]
        Margins.Left = 16
        Margins.Top = 16
        Margins.Right = 16
        PendingMarker.Content = smcNone
        PendingMarker.Size.Height = 16
        PendingMarker.Size.Width = 16
        Size.Height = 90
        Size.PlatformDefault = False
        TabOrder = 1
        StepItems = <
          item
            Caption = 'Profile'
          end
          item
            Caption = 'Skills'
          end
          item
            Caption = 'Experience'
          end
          item
            Caption = 'Documents'
          end
          item
            Caption = 'Review'
          end
          item
            Caption = 'Submit'
          end>
      end
    end
    object ShapesTab: TTabItem
      Text = 'Shapes'
      object ShapesLabel: TLabel
        Align = Top
        Margins.Left = 16
        Margins.Top = 16
        Margins.Right = 16
        Size.Height = 40
        Size.PlatformDefault = False
        TextSettings.VertAlign = Leading
        Text = 
          'A style of the style book (StyleLookup = SquareStepStyle): round' +
          'ed squares as markers and a dashed TLine for the pending line.'
      end
      object ShapesBar: TS4YStepProgressBar
        Align = Top
        CurrentStep = 2
        Interactions = [stiClickMarker, stiClickLabel, stiHandCursor, stiKeyboard, stiHover]
        LineThickness = 2
        Margins.Left = 16
        Margins.Top = 16
        Margins.Right = 16
        Size.Height = 90
        Size.PlatformDefault = False
        StyleLookup = 'SquareStepStyle'
        TabOrder = 1
        StepItems = <
          item
            Caption = 'Start'
            Marker.Content = smcNone
            MarkerStates = [sstCompleted, sstCurrent]
            MarkerStyleName = 'startmarker'
          end
          item
            Caption = 'Design'
          end
          item
            Caption = 'Build'
          end
          item
            Caption = 'Test'
          end
          item
            Caption = 'Release'
            Marker.Content = smcNone
            MarkerStates = [sstCurrent]
            MarkerStyleName = 'endmarker'
          end>
      end
    end
    object SpecialTab: TTabItem
      Text = 'Special step'
      object SpecialLabel: TLabel
        Align = Top
        Margins.Left = 16
        Margins.Top = 16
        Margins.Right = 16
        Size.Height = 40
        Size.PlatformDefault = False
        TextSettings.VertAlign = Leading
        Text = 
          'The step Review has a look of its own in every state: a star and' +
          ' a caption from the style (MarkerStyleName, LabelStyleName).'
      end
      object SpecialBar: TS4YStepProgressBar
        Align = Top
        CurrentStep = 1
        Interactions = [stiClickMarker, stiClickLabel, stiHandCursor, stiKeyboard, stiHover]
        Margins.Left = 16
        Margins.Top = 16
        Margins.Right = 16
        Size.Height = 90
        Size.PlatformDefault = False
        StyleLookup = 'ReviewStepStyle'
        TabOrder = 1
        StepItems = <
          item
            Caption = 'Draft'
            Marker.Content = smcNone
            MarkerStates = [sstCompleted, sstCurrent]
            MarkerStyleName = 'startmarker'
          end
          item
            Caption = 'Write'
          end
          item
            Caption = 'Review'
            Description = 'By the editor'
            LabelStyleName = 'reviewlabel'
            Marker.Content = smcNone
            Marker.Size.Height = 34
            Marker.Size.Width = 34
            MarkerStates = [sstCompleted, sstCurrent, sstPending]
            MarkerStyleName = 'reviewmarker'
          end
          item
            Caption = 'Publish'
            Marker.Content = smcNone
            MarkerStates = [sstCurrent]
            MarkerStyleName = 'endmarker'
          end>
      end
    end
    object CustomTab: TTabItem
      Text = 'Custom drawing'
      object CustomLabel: TLabel
        Align = Top
        Margins.Left = 16
        Margins.Top = 16
        Margins.Right = 16
        Size.Height = 40
        Size.PlatformDefault = False
        TextSettings.VertAlign = Leading
        Text = 
          'Markers and line drawn by the application in OnDrawMarker and On' +
          'DrawLine, in place of the parts of the style.'
      end
      object CustomBar: TS4YStepProgressBar
        Align = Top
        CurrentStep = 2
        Interactions = [stiClickMarker, stiClickLabel, stiHandCursor, stiKeyboard, stiHover]
        LineSpacing = 4
        LineThickness = 4
        Margins.Left = 16
        Margins.Top = 16
        Margins.Right = 16
        Size.Height = 90
        Size.PlatformDefault = False
        TabOrder = 1
        OnDrawLine = CustomBarDrawLine
        OnDrawMarker = CustomBarDrawMarker
        StepItems = <
          item
            Caption = 'Idea'
          end
          item
            Caption = 'Sketch'
          end
          item
            Caption = 'Prototype'
          end
          item
            Caption = 'Feedback'
          end
          item
            Caption = 'Product'
          end>
      end
    end
