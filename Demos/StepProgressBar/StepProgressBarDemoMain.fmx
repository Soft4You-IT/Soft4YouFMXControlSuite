  object DemoLayout: TLayout
    Align = Client
    Size.Width = 580.000000000000000000
    Size.Height = 830.000000000000000000
    Size.PlatformDefault = False
    TabOrder = 0
    object InstallTitleLabel: TLabel
      Position.X = 20.000000000000000000
      Position.Y = 16.000000000000000000
      Size.Width = 540.000000000000000000
      Size.Height = 20.000000000000000000
      Size.PlatformDefault = False
      Text = 
        'Installation: the buttons Previous and Next move the current ste' +
        'p'
      TabOrder = 1
    end
    object InstallBar: TS4YStepProgressBar
      CurrentStep = 1
      Position.X = 20.000000000000000000
      Position.Y = 44.000000000000000000
      Size.Width = 540.000000000000000000
      Size.Height = 90.000000000000000000
      Size.PlatformDefault = False
      OnStepChanged = InstallBarStepChanged
      StepItems = <
        item
          Caption = 'Start'
          Marker.Content = smcNone
          MarkerStates = [sstCompleted, sstCurrent]
          MarkerStyleName = 'startmarker'
        end
        item
          Caption = 'Download'
          Description = 'Package of 12 MB'
        end
        item
          Caption = 'Verify'
          Description = 'Checksum and signature'
        end
        item
          Caption = 'Copy files'
        end
        item
          Caption = 'Finish'
          Marker.Content = smcNone
          MarkerStates = [sstCurrent]
          MarkerStyleName = 'endmarker'
        end>
    end
    object WizardTitleLabel: TLabel
      Position.X = 20.000000000000000000
      Position.Y = 164.000000000000000000
      Size.Width = 540.000000000000000000
      Size.Height = 20.000000000000000000
      Size.PlatformDefault = False
      Text = 
        'Wizard: click a step, or click the bar and use the arrow keys, H' +
        'ome and End'
      TabOrder = 2
    end
    object WizardBar: TS4YStepProgressBar
      Interactions = [stiClickMarker, stiClickLabel, stiHandCursor, stiKeyboard, stiHover]
      Orientation = Vertical
      Position.X = 20.000000000000000000
      Position.Y = 192.000000000000000000
      Size.Width = 260.000000000000000000
      Size.Height = 300.000000000000000000
      Size.PlatformDefault = False
      TabOrder = 3
      OnStepChanged = WizardBarStepChanged
      OnStepChanging = WizardBarStepChanging
      StepItems = <
        item
          Caption = 'Account'
          Description = 'Name and e-mail'
          Marker.Content = smcNone
          MarkerStates = [sstCompleted, sstCurrent]
          MarkerStyleName = 'startmarker'
        end
        item
          Caption = 'Address'
          Description = 'Where to ship the order'
        end
        item
          Caption = 'Payment'
          Description = 'Card or bank transfer'
        end
        item
          Caption = 'Confirm'
          Marker.Content = smcNone
          MarkerStates = [sstCurrent]
          MarkerStyleName = 'endmarker'
        end>
    end
    object WizardStatusLabel: TLabel
      Position.X = 300.000000000000000000
      Position.Y = 192.000000000000000000
      Size.Width = 260.000000000000000000
      Size.Height = 120.000000000000000000
      Size.PlatformDefault = False
      TextSettings.VertAlign = Leading
      Text = 
        'Current step: Account. OnStepChanging does not allow skipping a ' +
        'step forward: click the next step, or any step before.'
      TabOrder = 4
    end
  end
