  Soft4You.HTML.Types in '..\..\Sources\HTMLEditor\Soft4You.HTML.Types.pas',
  Soft4You.HTML.Document in '..\..\Sources\HTMLEditor\Soft4You.HTML.Document.pas',
  Soft4You.HTML.Parser in '..\..\Sources\HTMLEditor\Soft4You.HTML.Parser.pas',
  Soft4You.HTML.Generator in '..\..\Sources\HTMLEditor\Soft4You.HTML.Generator.pas',
  Soft4You.HTML.ImageExporter in '..\..\Sources\HTMLEditor\Soft4You.HTML.ImageExporter.pas',
  Soft4You.HTML.Colors in '..\..\Sources\HTMLEditor\Soft4You.HTML.Colors.pas',
  Soft4You.FMX.Controls.FlexBox.Engine in '..\..\Sources\FlexBox\Soft4You.FMX.Controls.FlexBox.Engine.pas',
  Soft4You.FMX.Controls.FlexBox.Strings in '..\..\Sources\FlexBox\Soft4You.FMX.Controls.FlexBox.Strings.pas',
  Soft4You.FMX.Controls.FlexBox.Types in '..\..\Sources\FlexBox\Soft4You.FMX.Controls.FlexBox.Types.pas',
  Soft4You.FMX.Controls.FlexBox.SizeConstraints in '..\..\Sources\FlexBox\Soft4You.FMX.Controls.FlexBox.SizeConstraints.pas',
  Soft4You.FMX.Controls.FlexBox.ItemBase in '..\..\Sources\FlexBox\Soft4You.FMX.Controls.FlexBox.ItemBase.pas',
  Soft4You.FMX.Controls.FlexBox.Breakpoints in '..\..\Sources\FlexBox\Soft4You.FMX.Controls.FlexBox.Breakpoints.pas',
  Soft4You.FMX.Controls.FlexBox in '..\..\Sources\FlexBox\Soft4You.FMX.Controls.FlexBox.pas',
  Soft4You.FMX.Controls.Badge in '..\..\Sources\Badge\Soft4You.FMX.Controls.Badge.pas',
  Soft4You.FMX.Controls.Expander in '..\..\Sources\Expander\Soft4You.FMX.Controls.Expander.pas',
  Soft4You.FMX.Controls.BlockScrollBox.Abstracts in '..\..\Sources\BlockScrollBox\Soft4You.FMX.Controls.BlockScrollBox.Abstracts.pas',
  Soft4You.FMX.Controls.BlockScrollBox in '..\..\Sources\BlockScrollBox\Soft4You.FMX.Controls.BlockScrollBox.pas',
  Soft4You.FMX.Controls.ColorSelector.Types in '..\..\Sources\ColorSelector\Soft4You.FMX.Controls.ColorSelector.Types.pas',
